# Copie para .env e preencha. Nunca versione o .env.

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Domínio da VPS apontado para o IP do servidor (usado pelo Caddy para o HTTPS)
WIA_DOMINIO=wia.seudominio.com.br

# Segredo dos cookies de sessão (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
WIA_SECRET_KEY=

# true em produção (HTTPS). Use false só para testar em http://localhost
WIA_COOKIE_SECURE=true

# Modelo e esforço de raciocínio (low | medium | high | xhigh | max)
WIA_MODEL=claude-opus-5-5
WIA_EFFORT=high
WIA_USE_FALLBACKS=true

# Descrever fotos automaticamente com o Claude ao entrar na base
WIA_DESCRIBE_IMAGES=true

WIA_MAX_UPLOAD_MB=200

# Preços (US$ por milhão de tokens) usados só na estimativa de custo do painel
WIA_PRICE_INPUT=4.0
WIA_PRICE_OUTPUT=20.0
WIA_PRICE_CACHE_READ=0.20
WIA_PRICE_CACHE_WRITE=5.0
